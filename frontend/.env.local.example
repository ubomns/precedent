# Local dev override for the API base URL.
#
# Leave UNSET (default) when running `vercel dev` — Python serverless
# functions are served on the same port as the Next.js dev server, so
# `/api/*` requests resolve same-origin and Just Work.
#
# Set this only if you're running a separate FastAPI server (e.g. for
# fast iteration on the backend without Vercel's overhead).
# NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase (auth + Postgres). Uses the NEW API-key model:
#   - Publishable key (sb_publishable_...) replaces the old "anon" key — browser-safe.
#   - Secret key       (sb_secret_...)      replaces the old "service_role" key — SERVER ONLY.
# Find both under Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — never exposed to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# NOTE: No SUPABASE_JWT_SECRET is needed. The backend verifies access tokens with
# ASYMMETRIC signing keys via the project's JWKS endpoint
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json). Enable asymmetric signing under
# Supabase dashboard → Project Settings → JWT Keys (migrate to the P-256 / ES256 key
# and make it the current signing key).

# Required: OpenAI API key used by the BRD generation agents.
OPENAI_API_KEY=sk-...

# Stripe billing (Pro subscription). SCAFFOLD — leave unset to disable billing routes
# (they return 503; the rest of the app works). To enable:
#   1. Create a Product + recurring $15/mo Price in Stripe → copy the price id.
#   2. Set a webhook endpoint (POST <site>/api/billing/webhook) for events:
#      checkout.session.completed, customer.subscription.updated|deleted → copy its secret.
# All three are SERVER ONLY — never expose to the browser.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: comma-separated list of origins allowed by CORS.
# Defaults to the production domain plus local dev ports.
# ALLOWED_ORIGINS=https://precedent.app,http://localhost:3000,http://localhost:3001

# Optional: shared rate-limit store (Upstash Redis) for a global cap across serverless
# instances. Without it, slowapi limits are per-instance (best-effort).
# RATE_LIMIT_STORAGE_URI=rediss://default:<token>@<host>:<port>
