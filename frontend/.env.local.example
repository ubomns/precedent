# Local dev override for the API base URL.
#
# Leave UNSET (default) when running `vercel dev` — Python serverless
# functions are served on the same port as the Next.js dev server, so
# `/api/*` requests resolve same-origin and Just Work.
#
# Set this only if you're running a separate FastAPI server (e.g. for
# fast iteration on the backend without Vercel's overhead).
# NEXT_PUBLIC_API_URL=http://localhost:8001

# Supabase (auth + Postgres). Client + server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server only — never exposed to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# Required: OpenAI API key used by the BRD generation agents.
OPENAI_API_KEY=sk-...

# Optional: comma-separated list of origins allowed by CORS.
# Defaults to the production domain plus local dev ports.
# ALLOWED_ORIGINS=https://precedent.app,http://localhost:3000,http://localhost:3001
