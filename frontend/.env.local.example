# Local dev override for the API base URL.
#
# Leave UNSET (default) when running `vercel dev` — Python serverless
# functions are served on the same port as the Next.js dev server, so
# `/api/*` requests resolve same-origin and Just Work.
#
# Set this only if you're running a separate FastAPI server (e.g. for
# fast iteration on the backend without Vercel's overhead).
# NEXT_PUBLIC_API_URL=http://localhost:8001
